{
    "tabWidth": 4,
    "semi": false,
    "singleQuote": false,
    "trailingComma": "all",
    "printWidth": 100,
    "proseWrap": "preserve",
    "overrides": [
        {
            "files": ".prettierrc",
            "options": {
                "parser": "json"
            }
        },
        {
            "files": ["*.yaml", "*.yml"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
